# scratch space for re-running extraction/disassembly tools locally
/tmp/
*.tmp
/out/
/scratch/

# intermediate extraction artifacts reproducible from vendor/ via
# windows/tools/extract.sh -- not committed to avoid duplicating the
# ~74MB of vendor binaries a second time in extracted form
/windows/decompiled/**/inno/
/windows/decompiled/**/msix/

# bank images make_bank_image.py writes when it is run from inside this
# directory, where its usage examples spell the output path bare
# (`... 0 0x08000 bank0.bin`). Reproducible from ec/firmware/GMxMGxx_11.800
# and from nothing else in the tree reads them -- build_ec_decompile.py keeps
# its copies under its --work and verify_reassembly.py builds its own under
# its own IMAGE_DIR -- so they are build output, not exports like the .asm
# beside them.
/ec/decompiled/*.bin

# editor/OS noise
.DS_Store
*.swp

# python bytecode -- agent-gates.sh's py_compile check writes these as a
# side effect wherever it runs, including in every agent-pipeline run
__pycache__/
*.pyc

# agent-followups.yml's scratch context, written inside the checkout on
# purpose (see that workflow's comments) and never meant to be committed
.agent-context/

# Ghidra's project lock markers. Written while a project is open and removed
# when it closes; a committed one makes Ghidra treat the project as held by
# another process and refuse to open it. Scoped to the project directories
# rather than a blanket *.lock, which would hide unrelated files.
*/ghidra/project/*.lock
*/ghidra/project/*.lock~

# Claude Code's local state, which can appear inside a checkout. Also worth
# ignoring because agent-gates.sh's shellcheck pass runs `find . -name '*.sh'`
# and would otherwise walk any worktree checkout under here.
.claude/
